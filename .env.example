SISPL_DATA_SOURCE=postgres
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/sispl_ca_solution?connection_limit=30&pool_timeout=30
# Enable only behind a trusted reverse proxy that overwrites client IP headers.
AUTH_TRUST_PROXY_HEADERS=false
SISPL_PUBLIC_URL=http://localhost:3000
# Optional local-only seed override. If omitted, LOCAL_SETUP.md documents the development password.
# SISPL_DEV_ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# Notification delivery. Default `log` records alerts without sending them.
SISPL_EMAIL_TRANSPORT=log
# Required only when SISPL_EMAIL_TRANSPORT=http. Any JSON send API (Resend, Postmark, an internal relay).
# SISPL_EMAIL_ENDPOINT=https://api.example.com/emails
# SISPL_EMAIL_API_KEY=YOUR_API_KEY
# SISPL_EMAIL_FROM_ADDRESS=alerts@your-firm.example
# SISPL_EMAIL_FROM_NAME=Your Firm
# WhatsApp Business Cloud API. Default `off`; templates must be pre-approved by Meta.
SISPL_WHATSAPP_TRANSPORT=off
# SISPL_WHATSAPP_ENDPOINT=https://graph.facebook.com/v21.0/YOUR_PHONE_NUMBER_ID/messages
# SISPL_WHATSAPP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
# SISPL_WHATSAPP_TEMPLATE=sispl_practice_alert
# SISPL_WHATSAPP_COUNTRY_CODE=91
# Document storage: local (default, .data/documents) or s3 for private object storage.
SISPL_DOCUMENT_STORAGE=local
# Required only when SISPL_DOCUMENT_STORAGE=s3. Never commit real credentials.
# SISPL_S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# SISPL_S3_BUCKET=sispl-documents
# SISPL_S3_REGION=auto
# SISPL_S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# SISPL_S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# SISPL_S3_FORCE_PATH_STYLE=true
# SISPL_S3_PREFIX=
