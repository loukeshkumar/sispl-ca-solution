<?xml version="1.0" encoding="utf-8"?>
<!--
  SISPL CA Solution — Windows Server + Plesk, IIS as a reverse proxy to PM2.

  IIS no longer launches the application. PM2 owns the Node process and keeps it
  alive; IIS terminates HTTPS for the domain and forwards everything dynamic to
  127.0.0.1:3022, where server.js listens. See ecosystem.config.cjs.

  Requires on the host:
    - Application Request Routing (ARR) and URL Rewrite installed in IIS.
      Without ARR a Rewrite to an http:// address does not proxy — it 404s.
      Check: Get-WebGlobalModule | Where-Object Name -like "*ApplicationRequest*"
    - ARR proxying enabled at server level:
      Set-WebConfigurationProperty -PSPath 'MACHINE/WEBROOT/APPHOST' `
        -Filter system.webServer/proxy -Name enabled -Value True
    - Plesk > Node.js DISABLED for this domain, or it will fight for the port.
    - AUTH_TRUST_PROXY_HEADERS=true in the host's .env — every request now
      arrives from 127.0.0.1, and without it the login rate limiter treats the
      whole firm as one client.
-->
<configuration>
  <system.webServer>

    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>

    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Force HTTPS (same as the other Plesk sites) -->
        <rule name="HTTPS Redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Let IIS serve built Next static assets straight off disk. These are
             content-hashed and immutable, so there is nothing to gain from
             waking the Node process for them. -->
        <rule name="NextStatic" stopProcessing="true">
          <match url="^_next/static/(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Public files (favicon, landing images, etc.) -->
        <rule name="PublicFiles" stopProcessing="true">
          <match url="^(favicon\.svg|favicon\.ico|landing/.*|robots\.txt)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Everything else → the PM2-managed Node process.
             No IsFile condition here, unlike the iisnode arrangement this
             replaces: the application owns its own routes, and a request whose
             path happens to match a file on disk must still reach it. -->
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3022/{R:1}" />
          <serverVariables>
            <!-- The application is behind TLS even though this hop is not, and
                 it needs the browser's host to build absolute URLs. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <security>
      <requestFiltering removeServerHeader="true">
        <verbs allowUnlisted="true">
          <add verb="PUT" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="PATCH" allowed="true" />
        </verbs>
        <!-- 500 MB uploads (Tally XML / backups) -->
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <!-- Errors from the proxied application are its own; IIS must not replace
         them with its error pages. -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
